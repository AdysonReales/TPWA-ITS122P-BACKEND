PORT=5000
NODE_ENV=development

# Get this from Supabase: Project Settings > Database > Connection string (URI)
DATABASE_URL=postgresql://postgres:[PASSWORD]@[HOST]:[PORT]/postgres

# Any long random string. Generate one with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=your_super_secret_jwt_key_here

# Your frontend's URL, needed for CORS + cookies to work correctly
FRONTEND_URL=http://localhost:5173
